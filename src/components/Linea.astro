---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import creditos from '../data/imagenes.json';
import { SOCIEDADES, DISCIPLINAS, EPOCAS, TEXTOS, wikiUrl, type Lang } from '../linea-temporal';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = TEXTOS[lang];

const imagenes = creditos as Record<string, { src: string; ancho: number; alto: number; autor: string; licencia: string; fuente: string }>;
// Enlace de una película: en español se busca por su título; en inglés, por su artículo.
const peliUrl = (p: { titulo: string; wiki?: string }) =>
  wikiUrl(lang, lang === 'es' ? p.titulo.replace(/\s*\(.*\)$/, '') : p.wiki ?? p.titulo);

const hitos = (await getCollection('hitos'))
  .map((h) => ({ id: h.id, ...h.data }))
  .sort((a, b) => a.año - b.año || (a.pista === 'arte' ? -1 : 1));
type Hito = (typeof hitos)[number];
const fecha = (h: Hito) => h.fecha?.[lang] ?? (h.año < 0 ? t.ac(-h.año) : String(h.año));

// Columnas: las sociedades que tienen algún hito, en el orden de SOCIEDADES.
const columnas = Object.keys(SOCIEDADES).filter((s) => hitos.some((h) => h.sociedad === s));
// La columna 1 es el eje de fechas y la 2 un margen; las sociedades empiezan en la 3.
const col = (s: string) => columnas.indexOf(s) + 3;

// Filas del eje: una por hito, con una marca al empezar cada época.
type Fila = { epoca: (typeof EPOCAS)[number] } | { hito: Hito };
const filas: Fila[] = [];
let epocaActual = -1;
for (const h of hitos) {
  const e = EPOCAS.findIndex((x) => h.año < x.hasta);
  if (e !== epocaActual) { filas.push({ epoca: EPOCAS[e] }); epocaActual = e; }
  filas.push({ hito: h });
}

const disciplinas = Object.keys(DISCIPLINAS).filter((d) => hitos.some((h) => h.disciplinas.includes(d)));
---
<Base lang={lang} title={t.titulo} description={t.intro}>
  <h1 class="ink">{t.titulo}</h1>
  <p class="lede">{t.intro}</p>

  <div class="filtros" data-filtros hidden>
    <div role="group" aria-labelledby="f-disc">
      <p class="eyebrow" id="f-disc">{t.disciplinas}</p>
      <button type="button" data-disc="" aria-pressed="true">{t.todas}</button>
      {disciplinas.map((d) => <button type="button" data-disc={d} aria-pressed="false">{DISCIPLINAS[d][lang]}</button>)}
    </div>
  </div>
  <p class="meta">{t.pista}</p>

  <div class="linea" data-linea style={`--n:${columnas.length}`}>
    <div class="cabeza">
      <span class="eje-cab">{t.tiempo}</span>
      {columnas.map((s) => (
        <div class="col-cab" data-col={s} style={`grid-column:${col(s)}`}>
          <button type="button" data-abrir={s} aria-expanded="false"><span>{SOCIEDADES[s].nombre[lang]}</span></button>
          <p class="col-info">
            <span class="arte">{t.arte}</span> · <span>{t.mundo}</span> ·
            <a href={wikiUrl(lang, SOCIEDADES[s].wiki[lang])} rel="external">{t.historia} ↗</a>
          </p>
        </div>
      ))}
    </div>

    <div class="cuerpo">
      <div class="fondo" aria-hidden="true">
        {columnas.map((s) => <span data-col={s} style={`grid-column:${col(s)}`} />)}
      </div>
      <ol>
        {filas.map((f) => 'epoca' in f ? (
          <li class="sep" id={f.epoca.id}><span>{f.epoca.nombre[lang]} <small>{f.epoca.rango[lang]}</small></span></li>
        ) : (
          <li class={`fila ${f.hito.pista}`} data-col={f.hito.sociedad} data-disc={f.hito.disciplinas.join(' ')}>
            <span class="fecha">{fecha(f.hito)}</span>
            <div class="hito" style={`grid-column:${col(f.hito.sociedad)}`}>
              <button type="button" class="punto" data-abrir={f.hito.sociedad} data-ir={f.hito.id}
                title={`${SOCIEDADES[f.hito.sociedad].nombre[lang]}: ${f.hito[lang].titulo}`}
                aria-label={`${SOCIEDADES[f.hito.sociedad].nombre[lang]}: ${f.hito[lang].titulo}`}></button>
              <article class="tarjeta" id={f.hito.id}>
                {imagenes[f.hito.id] && (
                  <figure>
                    <img src={imagenes[f.hito.id].src} width={imagenes[f.hito.id].ancho} height={imagenes[f.hito.id].alto} alt="" loading="lazy" decoding="async" />
                    <figcaption><a href={imagenes[f.hito.id].fuente} rel="external">{t.imagen}</a>: {imagenes[f.hito.id].autor}{imagenes[f.hito.id].licencia && ` · ${imagenes[f.hito.id].licencia}`}</figcaption>
                  </figure>
                )}
                <span class="pista">{t[f.hito.pista]}</span>
                <h3>{f.hito[lang].titulo}</h3>
                <p class="texto">{f.hito[lang].texto}</p>
                {(f.hito.disciplinas.length > 0 || f.hito.wiki || f.hito.enlaces.length > 0) && (
                  <p class="meta">
                    {f.hito.disciplinas.map((d) => DISCIPLINAS[d][lang]).join(' · ')}
                    {f.hito.disciplinas.length > 0 && f.hito.wiki && ' · '}
                    {f.hito.wiki && <a href={wikiUrl(lang, f.hito.wiki[lang])} rel="external">Wikipedia ↗</a>}
                    {f.hito.enlaces.map((e) => <> · <a href={e.url} rel="external">{e.titulo} ↗</a></>)}
                  </p>
                )}
                {f.hito.peliculas.length > 0 && (
                  <div class="ver">
                    <p class="eyebrow">{t.verTambien}</p>
                    <ul>
                      {f.hito.peliculas.map((p) => (
                        <li><a href={peliUrl(p)} rel="external"><cite>{p.titulo}</cite></a> <span class="meta">({t.tipos[p.tipo]}, {p.año}{p.direccion && `, ${p.direccion}`})</span></li>
                      ))}
                    </ul>
                  </div>
                )}
              </article>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <p class="meta">{t.nota}</p>
</Base>

<script>
  const linea = document.querySelector<HTMLElement>('[data-linea]')!;
  const filtros = document.querySelector<HTMLElement>('[data-filtros]')!;
  const columnas = [...linea.querySelectorAll<HTMLElement>('.col-cab')].map((c) => c.dataset.col!);
  filtros.hidden = false;
  const elegidas = new Set<string>();
  let abierta = '';

  function plantilla() {
    const movil = matchMedia('(max-width: 40rem)').matches;
    const eje = movil ? '4.6rem' : '7rem';
    const cols = columnas.map((c) => (!abierta ? 'minmax(0, 1fr)' : c === abierta ? 'minmax(0, 1fr)' : movil ? '0' : '2.4rem'));
    linea.style.setProperty('--plantilla', [eje, '.9rem', ...cols].join(' '));
  }

  function abrir(s: string) {
    abierta = s;
    if (s) linea.dataset.abierta = s; else delete linea.dataset.abierta;
    linea.querySelectorAll<HTMLElement>('[data-col]').forEach((el) => el.classList.toggle('abierta', !!s && el.dataset.col === s));
    linea.querySelectorAll<HTMLButtonElement>('.col-cab > button').forEach((b) => b.setAttribute('aria-expanded', String(b.dataset.abrir === s)));
    plantilla();
    separadores();
    history.replaceState(null, '', s ? `#${s}` : location.pathname);
  }

  function filtrar() {
    filtros.querySelectorAll<HTMLButtonElement>('[data-disc]').forEach((b) => {
      const v = b.dataset.disc!;
      b.setAttribute('aria-pressed', String(v ? elegidas.has(v) : elegidas.size === 0));
    });
    linea.querySelectorAll<HTMLElement>('.fila.arte').forEach((f) => {
      f.hidden = elegidas.size > 0 && !(f.dataset.disc ?? '').split(' ').some((d) => elegidas.has(d));
    });
    separadores();
  }

  // Oculta las marcas de época que se quedan sin ningún hito visible.
  function separadores() {
    linea.querySelectorAll<HTMLElement>('.sep').forEach((sep) => {
      let el = sep.nextElementSibling as HTMLElement | null;
      let alguno = false;
      while (el && !el.classList.contains('sep')) {
        if (el.offsetParent !== null) { alguno = true; break; }
        el = el.nextElementSibling as HTMLElement | null;
      }
      sep.hidden = !alguno;
    });
  }

  filtros.addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-disc]');
    if (!b) return;
    const d = b.dataset.disc!;
    if (!d) elegidas.clear(); else if (elegidas.has(d)) elegidas.delete(d); else elegidas.add(d);
    filtrar();
  });

  linea.addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-abrir]');
    if (!b) return;
    const s = b.dataset.abrir!;
    const ir = b.dataset.ir;
    abrir(!ir && s === abierta ? '' : s);
    if (ir) document.getElementById(ir)?.scrollIntoView({ block: 'center' });
  });

  addEventListener('resize', () => { plantilla(); separadores(); });
  const inicial = decodeURIComponent(location.hash.slice(1));
  abrir(columnas.includes(inicial) ? inicial : '');
</script>
